// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  interview     Interview[]

  @@unique([email])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model InterviewLevel {
  id          String            @id @default(uuid())
  levelName   String            @map("level_name")
  description String
  createdAt   DateTime          @default(now()) @map("created_at")
  interview   Interview[]
  prompt      InterviewPrompt[]

  @@map("interview_levels")
}

model InterviewSpecialty {
  id            String            @id @default(uuid())
  specialtyName String            @map("specialty_name")
  description   String
  createdAt     DateTime          @default(now()) @map("created_at")
  interview     Interview[]
  prompt        InterviewPrompt[]

  @@map("interview_specialties")
}

model Interview {
  id               String              @id @default(uuid())
  user             User                @relation(fields: [userId], references: [id])
  userId           String              @map("user_id")
  level            InterviewLevel      @relation(fields: [levelId], references: [id])
  levelId          String              @map("interview_level_id")
  specialty        InterviewSpecialty  @relation(fields: [specialtyId], references: [id])
  specialtyId      String              @map("interview_specialty_id")
  prompt           InterviewPrompt     @relation(fields: [promptId], references: [id])
  promptId         String              @map("prompt_id")
  status           InterviewStatus     @default(IN_PROGRESS) @map("interview_status")
  assessmentStatus AssessmentStatus    @default(PENDING) @map("assessment_status")
  startedAt        DateTime            @default(now()) @map("started_at")
  completedAt      DateTime?           @map("completed_at")
  questions        InterviewQuestion[]
  assessment       Assessment[]
  result           AssessmentResult?

  @@map("interviews")
}

model InterviewQuestion {
  id            String       @id @default(uuid())
  interview     Interview    @relation(fields: [interviewId], references: [id])
  interviewId   String       @map("interview_id")
  questionText  String       @map("question_text")
  userAnswer    String       @map("user_answer")
  sequenceOrder Int          @map("sequence_order")
  createdAt     DateTime     @default(now()) @map("created_at")
  assessment    Assessment[]

  @@map("interview_questions")
}

model InterviewPrompt {
  id           String             @id @default(uuid())
  level        InterviewLevel     @relation(fields: [levelId], references: [id])
  levelId      String             @map("interview_level_id")
  specialty    InterviewSpecialty @relation(fields: [specialtyId], references: [id])
  specialtyId  String             @map("interview_specialty_id")
  systemPrompt String             @map("system_prompt")
  createdAt    DateTime           @default(now()) @map("created_at")
  interview    Interview[]

  @@map("interview_prompts")
}

model Assessment {
  id              String            @id @default(uuid())
  interview       Interview         @relation(fields: [interviewId], references: [id])
  interviewId     String            @map("interview_id")
  question        InterviewQuestion @relation(fields: [questionId], references: [id])
  questionId      String            @map("question_id")
  questionRating  Int               @map("question_rating")
  remarks         String
  topicReferences String[]          @map("topic_references")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("assessments")
}

model AssessmentResult {
  id           String    @id @default(uuid())
  interview    Interview @relation(fields: [interviewId], references: [id])
  interviewId  String    @unique @map("interview_id")
  overallGrade Int       @map("overall_grade")
  description  String
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("assessment_results")
}

enum AssessmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}
