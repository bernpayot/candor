// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  createdAt  DateTime    @default(now()) @map("created_at")
  interviews Interview[]

  @@map("users")
}

model InterviewLevel {
  id          String            @id @default(uuid())
  levelName   String            @map("level_name")
  description String
  createdAt   DateTime          @default(now()) @map("created_at")
  interview   Interview[]
  prompt      InterviewPrompt[]

  @@map("interview_level")
}

model InterviewSpecialty {
  id            String            @id @default(uuid())
  specialtyName String            @map("specialty_name")
  description   String
  createdAt     DateTime          @default(now()) @map("created_at")
  interview     Interview[]
  prompt        InterviewPrompt[]

  @@map("interview_specialty")
}

model Interview {
  id               String              @id @default(uuid())
  user             User                @relation(fields: [userId], references: [id])
  userId           String              @map("user_id")
  level            InterviewLevel      @relation(fields: [levelId], references: [id])
  levelId          String              @map("interview_level_id")
  specialty        InterviewSpecialty  @relation(fields: [specialtyId], references: [id])
  specialtyId      String              @map("interview_specialty_id")
  prompt           InterviewPrompt     @relation(fields: [promptId], references: [id])
  promptId         String              @map("prompt_id")
  status           InterviewStatus     @default(IN_PROGRESS) @map("interview_status")
  assessmentStatus AssessmentStatus    @default(PENDING) @map("assessment_status")
  startedAt        DateTime            @default(now()) @map("started_at")
  completedAt      DateTime?           @map("completed_at")
  questions        InterviewQuestion[]
  assessment       Assessment[]
  result           AssessmentResult?

  @@map("interviews")
}

model InterviewQuestion {
  id            String       @id @default(uuid())
  interview     Interview    @relation(fields: [interviewId], references: [id])
  interviewId   String       @map("interview_id")
  questionText  String       @map("question_text")
  userAnswer    String       @map("user_answer")
  sequenceOrder Int          @map("sequence_order")
  createdAt     DateTime     @default(now()) @map("created_at")
  assessment    Assessment[]

  @@map("interview_questions")
}

model InterviewPrompt {
  id           String             @id @default(uuid())
  level        InterviewLevel     @relation(fields: [levelId], references: [id])
  levelId      String             @map("interview_level_id")
  specialty    InterviewSpecialty @relation(fields: [specialtyId], references: [id])
  specialtyId  String             @map("interview_specialty_id")
  systemPrompt String             @map("system_prompt")
  createdAt    DateTime           @default(now()) @map("created_at")
  interview    Interview[]

  @@map("interview_prompts")
}

model Assessment {
  id              String            @id @default(uuid())
  interview       Interview         @relation(fields: [interviewId], references: [id])
  interviewId     String            @map("interview_id")
  question        InterviewQuestion @relation(fields: [questionId], references: [id])
  questionId      String            @map("question_id")
  questionRating  Int               @map("question_rating")
  remarks         String
  topicReferences String[]          @map("topic_references")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("assessment")
}

model AssessmentResult {
  id           String    @id @default(uuid())
  interview    Interview @relation(fields: [interviewId], references: [id])
  interviewId  String    @unique @map("interview_id")
  overallGrade Int       @map("overall_grade")
  description  String
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("assessment_result")
}

enum AssessmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}
